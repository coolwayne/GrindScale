# Copy to Render / Fly / VPS environment variables.
# CORS must include your LIFF site origin (comma-separated, no spaces).

CORS_ORIGINS=https://grindscale.pages.dev,https://your-project.pages.dev
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_DIMENSION_PX=2048
REQUIRE_LIFF_TOKEN=false

# Optional Phase 4: verify LIFF access token on POST /v1/analyze
# LINE_CHANNEL_ID=
# REQUIRE_LIFF_TOKEN=true
