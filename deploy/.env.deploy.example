# Copy to deploy/.env.deploy (gitignored) for: ./scripts/bootstrap-cloud.sh deploy
# Get Cloudflare token: Dashboard → My Profile → API Tokens → Create Token
#   Template: "Edit Cloudflare Workers" or custom with Account + Pages Edit

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Predictable URLs (change project/service names if taken)
PAGES_PROJECT=grindscale-liff
PAGES_URL=https://grindscale-liff.pages.dev
RENDER_SERVICE=grindscale-api
RENDER_API_URL=https://grindscale-api.onrender.com

VITE_API_BASE=https://grindscale-api.onrender.com
VITE_LIFF_ID=

CORS_ORIGINS=https://grindscale-liff.pages.dev
